[Unit]
Description=ShengDi resident recalibration product
After=local-fs.target

[Service]
Type=simple
User=xilinx
WorkingDirectory=/opt/shengdi/current
ExecStart=/bin/bash /opt/shengdi/current/recal_entry.sh --state-dir /home/xilinx/.local/state/shengdi
Restart=on-failure
RestartSec=3
TimeoutStopSec=3
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
